# ==============================================================================
# AL GONAID E-LEARNING PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================
# This file serves as a template for your local .env file.
# Copy this file to .env and fill in the actual values.
# IMPORTANT: Never commit the .env file to source control!

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# The port on which the NestJS application will run.
PORT=3000

# The URL of your frontend application (used for email links).
FRONTEND_URL="http://localhost:5000"

# Environment mode: 'development', 'production', or 'test'.
NODE_ENV="development"


# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL / Neon)
# ------------------------------------------------------------------------------
# Connection string for your PostgreSQL database.
# For production (Neon), use the 'pooled' connection string.
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/algonaid_db?sslmode=disable"


# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# A long, random string used to sign JWT access tokens.
JWT_SECRET="generate_a_long_random_secret_here"

# Token expiration time (e.g., '1d', '12h', '30m').
JWT_EXPIRES_SECRET="1d"


# ------------------------------------------------------------------------------
# 4. SOCIAL LOGIN (Google OAuth 2.0)
# ------------------------------------------------------------------------------
# Obtain these from the Google Cloud Console (https://console.cloud.google.com/)
# Create a project, enable "Google People API", and create OAuth 2.0 credentials.
GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# The URL Google will redirect to after successful authentication.
# Must match the "Authorized redirect URIs" in Google Console.
GOOGLE_CALLBACK_URL="http://localhost:3000/api/v1/auth/google/callback"


# ------------------------------------------------------------------------------
# 5. CLOUD STORAGE (Uploadcare)
# ------------------------------------------------------------------------------
# Used for handling image and file uploads (Avatar, Backgrounds, PDFs).
# Get your API keys from https://uploadcare.com/dashboard/
UPLOADCARE_PUBLIC_KEY="your_public_key_here"


# ------------------------------------------------------------------------------
# 6. EMAIL SERVICE (Optional / Future)
# ------------------------------------------------------------------------------
# If you plan to use Resend or another provider for password resets.
 RESEND_API_KEY="re_your_api_key_here"
# EMAIL_FROM="Al Gonaid Platform <noreply@algonaid.com>"
