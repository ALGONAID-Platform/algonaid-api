// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT // who will browse the platform
  ADMIN // teacher who will upload the content 
  OWNER // who has all privalges
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
  role     Role   @default(STUDENT)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  studentProfile Student?
  teacherProfile Teacher?
}

model Student {
  id         Int       @id @default(autoincrement())
  academicId String    @unique
  grade      String? // الصف الدراسي
  birthDate  DateTime?
  address    String?

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])

  enrollments Enrollment[] // one user can have many courses  
}

model Teacher {
  id             Int     @id @default(autoincrement())
  specialization String
  bio            String? @db.Text
  experience     Int     @default(0) // سنوات الخبرة

  userId  Int      @unique
  user    User     @relation(fields: [userId], references: [id])
  courses Course[]
}

model Enrollment {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentId Int
  student      Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // حالة التسجيل (اختياري)
  status  EnrollmentStatus @default(ACTIVE)

  @@unique([studentId, courseId]) // لمنع المستخدم من التسجيل في نفس الكورس مرتين
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model Course {
  id          Int     @id @default(autoincrement())
  title       String
  description String? @db.Text
  thumbnail   String? // رابط صورة الغلاف

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments Enrollment[]

  instructorId Int
  teacher      Teacher @relation(fields: [instructorId], references: [id])
}
