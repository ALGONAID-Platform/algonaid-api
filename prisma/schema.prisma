// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT // who will browse the platform
  ADMIN // teacher who will upload the content 
  OWNER // who has all privalges
}

enum CourseType {
  RECORDED // كورس مسجل عادي
  LIVE // دورة تفاعلية مباشرة
}

enum LiveStatus {
  SCHEDULED // مجدول لم يبدأ بعد
  LIVE_NOW // بث مباشر الآن
  COMPLETED // منتهي وتم رفع التسجيل
}

enum PaymentStatus {
  PENDING // قيد المراجعة
  APPROVED // تم التأكيد وتفعيل الكورس
  REJECTED // مرفوض
}

enum Currency {
  YER_OLD // ريال يمني - عملة قديمة
  YER_NEW // ريال يمني - عملة جديدة
  SAR     // ريال سعودي
  USD     // دولار أمريكي
}

enum AssignmentType {
  QUIZ // كويز اختياري
  TASK // تكليف ومهمة عملية
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  GRADED
  RESUBMISSION_REQUESTED
}

model User {
  id                   Int       @id @default(autoincrement())
  name                 String
  email                String    @unique
  password             String?
  googleId             String?   @unique
  resetPasswordToken   String?   @unique
  resetPasswordExpires DateTime?
  role                 Role      @default(STUDENT)
  avatar               String?
  background           String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // ==================== Email Verification ====================
  emailVerified           Boolean   @default(false)
  verificationToken       String?   @unique
  verificationTokenExpiry DateTime?
  // ===========================================================

  studentProfile   Student?
  teacherProfile   Teacher?
  comments         Comment[]
  mentionsReceived Mention[]

  // ==================== Posts Relations ====================
  posts        Post[]
  postComments PostComment[]
  postLikes    PostLike[]
  pollVotes    PollVote[]
  postViews    PostView[]

  // ==================== Payments Relations ====================
  reviewedPayments Payment[] @relation("ReviewedPayments")

  // ==================== Assignments Relations ====================
  gradedSubmissions AssignmentSubmission[] @relation("GradedSubmissions")
}

model Student {
  id             Int              @id @default(autoincrement())
  academicId     String           @unique
  bio            String?          @db.Text
  grade          String? // الصف الدراسي
  birthDate      DateTime?
  address        String?
  userId         Int              @unique
  user           User             @relation(fields: [userId], references: [id])
  enrollments    Enrollment[] // one user can have many courses  
  payments       Payment[]
  examAttempts   ExamAttempt[]
  lessonProgress LessonProgress[]
  earnedBadges   EarnedBadge[] // الأوسمة المكتسبة بشكل دائم
  assignmentSubmissions AssignmentSubmission[]
  certificates          Certificate[]
  courseReviews         CourseReview[]
}

// جدول الأوسمة المكتسبة بشكل دائم
// بمجرد إدراج سجل هنا، لا يمكن سحب الوسام حتى لو أضاف الأستاذ محتوى جديد
model EarnedBadge {
  id       Int      @id @default(autoincrement())
  key      String // مفتاح الوسام (starter, marathon, nerd, etc.)
  tier     String   @default("STANDARD") // STANDARD | PRO | PRO_MAX
  earnedAt DateTime @default(now())

  studentId Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, key]) // كل طالب لا يحصل على نفس الوسام مرتين
}

model Teacher {
  id             Int            @id @default(autoincrement())
  specialization String
  bio            String?        @db.Text
  experience     Int            @default(0) // سنوات الخبرة
  userId         Int            @unique
  user           User           @relation(fields: [userId], references: [id])
  courses        Course[]
  practiceExams  PracticeExam[]
}

model Enrollment {
  id        Int              @id @default(autoincrement())
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  studentId Int
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId  Int
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status    EnrollmentStatus @default(ACTIVE)

  @@unique([studentId, courseId]) // لمنع المستخدم من التسجيل في نفس الكورس مرتين
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model Course {
  id            Int            @id @default(autoincrement())
  title         String
  description   String?        @db.Text
  thumbnail     String? // رابط صورة الغلاف
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  enrollments   Enrollment[]
  instructorId  Int
  teacher       Teacher        @relation(fields: [instructorId], references: [id])
  // Paid & Live Cohorts
  isPaid            Boolean        @default(false)
  price             Decimal?       @db.Decimal(10, 2)
  discountedPrice   Decimal?       @db.Decimal(10, 2)

  // Multi-Currency Pricing (Yemen & Gulf)
  priceYerOld           Decimal?   @db.Decimal(12, 2)
  discountedPriceYerOld Decimal?   @db.Decimal(12, 2)
  priceYerNew           Decimal?   @db.Decimal(12, 2)
  discountedPriceYerNew Decimal?   @db.Decimal(12, 2)
  priceSar              Decimal?   @db.Decimal(10, 2)
  discountedPriceSar    Decimal?   @db.Decimal(10, 2)

  courseType        CourseType     @default(RECORDED)
  scheduleDaysText  String? // أيام وتوقيت المحاضرات للبث المباشر
  payments          Payment[]

  // Course Dates, Schedule & Objectives
  startDate                DateTime?
  endDate                  DateTime?
  durationWeeks            Int?
  scheduleDays             String[]       @default([])
  objectives               String[]       @default([])
  certificateMinScore      Int            @default(70)
  certificateMinAttendance Int            @default(80)

  certificates             Certificate[]
  reviews                  CourseReview[]

  modules       Module[]
  practiceExams PracticeExam[]
  exams         Exam[] // اختبارات الكورس
}

model Module {
  id          Int      @id @default(autoincrement())
  title       String
  description String?  @db.Text
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  courseId    Int
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
}

enum LessonStatus {
  DRAFT
  PUBLISHED
}

model Lesson {
  id             Int              @id @default(autoincrement())
  title          String
  description    String?          @db.Text
  content        String?          @db.Text
  videoUrl       String?
  pdfUrl         String?
  imageUrl       String? // صورة أو غلاف الدرس
  status         LessonStatus     @default(DRAFT)
  isReading      Boolean          @default(false)
  order          Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  // Paid & Live Features
  isFreePreview     Boolean          @default(false) // معاينة مجانية للطلاب غير المشتركين
  liveMeetingUrl    String? // رابط زوم أو جوجل ميت (محجوب عن غير المشتركين)
  scheduledAt       DateTime? // موعد المحاضرة المباشرة
  durationMinutes   Int? // مدة المحاضرة بالدقائق
  liveStatus        LiveStatus? // حالة البث (SCHEDULED, LIVE_NOW, COMPLETED)
  recordingVideoUrl String? // تسجيل البث بعد انتهائه

  // Tracking & Objectives
  dayNumber         Int?             // رقم اليوم في الدورة
  objectives        String[]         @default([]) // أهداف ومخرجات هذا الدرس
  isMandatory       Boolean          @default(true) // حضور إلزامي لاستحقاق الشهادة

  moduleId       Int
  module         Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  exam           Exam?
  assignment     Assignment?
  lessonProgress LessonProgress[]
  comments       Comment[]
}

enum ExamType {
  LESSON_QUIZ // اختبار درس عادي
  COURSE_QUIZ // اختبار كورس دائم مع Leaderboard
  CHALLENGE // تحدي مؤقت له وقت بداية ونهاية
}

enum RankingCriteria {
  SCORE // الترتيب بالدرجة فقط
  SPEED // الترتيب بالسرعة فقط
  BOTH // الدرجة أولاً ثم السرعة كفاصل (افتراضي)
}

model Exam {
  id              Int             @id @default(autoincrement())
  title           String
  description     String?         @db.Text
  imageUrl        String? // صورة الاختبار
  passingScore    Int             @default(50)
  maxAttempts     Int             @default(1)
  timeLimit       Int? // مدة الاختبار بالدقائق (null = بلا حد)
  examType        ExamType        @default(LESSON_QUIZ)
  rankingCriteria RankingCriteria @default(BOTH)

  // حقول خاصة بالتحدي (CHALLENGE)
  startTime DateTime? // وقت بدء التحدي
  endTime   DateTime? // وقت انتهاء التحدي

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // اختبار درس (اختياري)
  lessonId Int?    @unique
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  // اختبار كورس (اختياري)
  courseId Int?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  assignment Assignment?
  questions  Question[]
  attempts   ExamAttempt[]
  comments   Comment[]
}

model Question {
  id          Int          @id @default(autoincrement())
  text        String       @db.Text
  type        QuestionType @default(MULTIPLE_CHOICE)
  points      Int          @default(1)
  imageUrl    String?
  examId      Int
  exam        Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  options     Option[]
  userAnswers UserAnswer[]
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
}

model Option {
  id        Int     @id @default(autoincrement())
  text      String
  isCorrect Boolean @default(false)

  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  userAnswers UserAnswer[]
}

model ExamAttempt {
  id          Int        @id @default(autoincrement())
  score       Int        @default(0)
  status      ExamStatus @default(IN_PROGRESS)
  startedAt   DateTime   @default(now())
  completedAt DateTime?
  timeTaken   Int? // الوقت المستغرق بالميلي ثانية
  isRanked    Boolean    @default(false) // هل هذه المحاولة محسوبة في الترتيب؟

  studentId Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  examId Int
  exam   Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  answers UserAnswer[]
}

enum ExamStatus {
  IN_PROGRESS
  PASSED
  FAILED
  IMPROVEMENT_NEEDED
}

model UserAnswer {
  id Int @id @default(autoincrement())

  attemptId Int
  attempt   ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  selectedOptionId Int
  selectedOption   Option @relation(fields: [selectedOptionId], references: [id])
}

model LessonProgress {
  id          Int       @id @default(autoincrement())
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  watchCount  Int       @default(1)

  studentId Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  lessonId Int
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
}

model TokenBlacklist {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
}

model PracticeExam {
  id          Int      @id @default(autoincrement())
  title       String
  description String?  @db.Text
  pdfUrl      String?
  grade       String?
  courseId    Int?
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacherId   Int
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Comment {
  id        Int      @id @default(autoincrement())
  text      String   @db.Text
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  lessonId Int?
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  examId Int?
  exam   Exam? @relation(fields: [examId], references: [id], onDelete: Cascade)

  parentId Int?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  mentions Mention[]
}

model Mention {
  id        Int      @id @default(autoincrement())
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  commentId Int?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  postCommentId Int?
  postComment   PostComment? @relation(fields: [postCommentId], references: [id], onDelete: Cascade)

  postId Int?
  post   Post? @relation(fields: [postId], references: [id], onDelete: Cascade)

  mentionedUserId Int
  mentionedUser   User @relation(fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@index([mentionedUserId])
  @@index([postCommentId])
  @@index([postId])
}

// ===========================================================
// Posts & Comments Module
// ===========================================================

model Post {
  id            Int     @id @default(autoincrement())
  title         String?
  content       String  @db.Text
  imageUrl      String?
  videoUrl      String?
  views         Int     @default(0)
  isPoll        Boolean @default(false)
  allowComments Boolean @default(true)

  authorId Int
  author   User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  comments    PostComment[]
  likes       PostLike[]
  pollOptions PollOption[]
  pollVotes   PollVote[]
  postViews   PostView[]
  mentions    Mention[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PostView {
  id Int @id @default(autoincrement())

  postId Int
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model PollOption {
  id   Int    @id @default(autoincrement())
  text String

  postId Int
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  votes PollVote[]
}

model PollVote {
  id Int @id @default(autoincrement())

  optionId Int
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // We want to ensure a user only votes once per post, not just per option.
  // To do that easily in Prisma, we can store postId in PollVote too.
  postId Int
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model PostLike {
  id Int @id @default(autoincrement())

  postId Int
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model PostComment {
  id       Int     @id @default(autoincrement())
  text     String  @db.Text
  imageUrl String?

  postId Int
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  parentId Int?
  parent   PostComment?  @relation("PostCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  PostComment[] @relation("PostCommentReplies")

  mentions Mention[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentAccount {
  id            Int       @id @default(autoincrement())
  providerTitle String    // اسم الخدمة: مثلاً "بنك الكريمي", "محفظة ون كاش", "جايبي", "القطيبي", "النجم"
  accountHolder String    // اسم صاحب الحساب: مثلاً "بشار أحمد الجنيد"
  accountNumber String    // رقم الحساب أو المحفظة
  currency      Currency? // العملة المدعومة بهذا الحساب (أو null لجميع العملات)
  instructions  String?   @db.Text // تعليمات التحويل
  qrCodeUrl     String?   // صورة باركود الحساب إن وجدت
  isActive      Boolean   @default(true) // تفعيل أو تعطيل الحساب من الظهور للطلاب
  order         Int       @default(0) // ترتيب الظهور في التطبيق
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  payments      Payment[]

  @@index([isActive])
  @@index([order])
}

model Payment {
  id                Int             @id @default(autoincrement())
  studentId         Int
  student           Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId          Int
  course            Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  amount            Decimal         @db.Decimal(12, 2)
  currency          Currency        @default(YER_OLD)
  transactionNumber String?         // رقم عملية الحوالة / السند
  paymentAccountId  Int?
  paymentAccount    PaymentAccount? @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)
  receiptUrl        String          // صورة سند الدفع أو الوصل
  status            PaymentStatus   @default(PENDING)
  rejectionReason   String?         @db.Text
  reviewedById      Int?
  reviewedBy        User?           @relation("ReviewedPayments", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?
  notes             String?         @db.Text
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([studentId])
  @@index([courseId])
  @@index([status])
  @@index([paymentAccountId])
  @@index([currency])
}

model Assignment {
  id            Int            @id @default(autoincrement())
  title         String
  description   String?        @db.Text
  type          AssignmentType @default(TASK)
  maxScore      Int            @default(100)
  dueDate       DateTime?
  attachmentUrl String?        // ملف مرفق من المعلم (PDF، صورة، تعليمات)

  lessonId      Int            @unique
  lesson        Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  examId        Int?           @unique
  exam          Exam?          @relation(fields: [examId], references: [id], onDelete: SetNull)

  submissions   AssignmentSubmission[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model AssignmentSubmission {
  id               Int              @id @default(autoincrement())

  assignmentId     Int
  assignment       Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  studentId        Int
  student          Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // تسليم الطالب
  content          String?          @db.Text
  fileUrl          String?
  submittedAt      DateTime         @default(now())
  status           SubmissionStatus @default(SUBMITTED)

  // تقييم وتصحيح المعلم
  score            Int?
  feedback         String?          @db.Text
  feedbackImageUrl String?
  gradedAt         DateTime?
  gradedById       Int?
  gradedBy         User?            @relation("GradedSubmissions", fields: [gradedById], references: [id], onDelete: SetNull)

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@index([status])
}

model Certificate {
  id           Int      @id @default(autoincrement())
  serialNumber String   @unique // كود تسلسلي فريد، مثلاً: ALG-2026-C5-S12
  studentId    Int
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId     Int
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  finalGrade   Decimal  @db.Decimal(5, 2) // الدرجة التراكمية النهائية (مثلاً: 94.50)
  issueDate    DateTime @default(now())   // تاريخ إصدار الشهادة
  pdfUrl       String?                    // رابط تحميل ملف الشهادة
  qrCodeUrl    String?                    // رابط عام موثق للتحقق من صحة الشهادة
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([studentId, courseId])
  @@index([serialNumber])
  @@index([studentId])
  @@index([courseId])
}

model CourseReview {
  id        Int      @id @default(autoincrement())
  rating    Int      // التقييم من 1 إلى 5 نجوم
  comment   String?  @db.Text
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId  Int
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, courseId])
  @@index([courseId])
  @@index([studentId])
}

